{
  "name": "ai-speaker-stage-0",
  "private": true,
  "version": "0.0.0",
  "description": "Throwaway audio prototype: cloned voice into a meeting through virtual audio devices.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file-if-exists=../../.env --watch server/index.ts",
    "dev:web": "vite",
    "tts-check": "node --env-file-if-exists=../../.env server/tts-check.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
