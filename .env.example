# AI Speaker - environment template.
# Copy this file to .env and fill in the values. Never commit .env.

# --- Inworld: voice clone, text-to-speech, speech-to-text, live answers ---
# Inworld Portal -> API Keys -> copy the Base64 credential.
INWORLD_API_KEY=

# Id of your cloned voice: Inworld Portal -> TTS Playground -> copy the voice ID.
# Keep it out of git: it identifies your voice.
INWORLD_VOICE_ID=

# --- LLM used to generate the outline, slides and script ---
# Any OpenAI-compatible endpoint works. Pick one provider and set all three values.
#   Google Gemini (free tier):    https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq (free tier):             https://api.groq.com/openai/v1
#   OpenRouter (":free" models):  https://openrouter.ai/api/v1
LLM_BASE_URL=
LLM_API_KEY=
# Model id exactly as your provider lists it.
LLM_MODEL=

# --- Local ports (optional) ---
# SERVER_PORT=8787
# STAGE_PORT=3030
# CONTROL_PORT=5173
